# Dépendances locales (Docker va les installer lui-même proprement)
/vendor
/node_modules

# Fichiers de configuration sensibles (on utilise le .env du container)
.env
.env.backup
.env.production

# Tests et Git
/.git
/.github
/tests
.gitignore
.dockerignore

# Logs et caches de développement
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php

# Divers
.phpunit.result.cache
Docker/
.vscode/
.idea/
npm-debug.log
